---
import BaseLayout from '../layouts/BaseLayout.astro';
import { identity, amenities, contact } from '../config/site.config';
---

<BaseLayout title="À propos" path="/a-propos">
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="font-display text-4xl font-bold">À propos de {identity.shortName}</h1>

    <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="space-y-4 text-text-muted">
        <!--
          PLACEHOLDER STORY — replace with the real history of Zayna: who
          opened it, when, what inspired the name/concept, what makes it
          different. Two short paragraphs is plenty.
        -->
        <p>
          {identity.name} est un café installé au cœur de {contact.address.city}, pensé comme un lieu où
          prendre le temps — que ce soit pour un café rapide, un rendez-vous, ou une pause plus
          longue en terrasse.
        </p>
        <p>
          Le nom et l'identité visuelle du café s'inspirent du patrimoine marocain, mêlé à une
          ambiance contemporaine et chaleureuse.
        </p>
        <p class="italic text-sm">
          (Texte à personnaliser avec la vraie histoire du café — contactez-nous pour le remplacer.)
        </p>
      </div>
      <!-- PHOTO: team / interior photo -->
      <div class="photo-placeholder aspect-square rounded-2xl">Photo à venir — équipe ou intérieur</div>
    </div>

    <div class="mt-16">
      <h2 class="font-display text-2xl font-semibold">Ce que nous offrons</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {amenities.map((a) => (
          <li class="rounded-xl border border-border bg-surface-muted p-5 text-sm font-medium">{a}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
