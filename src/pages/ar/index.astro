---
// Arabic homepage stub (RTL). Only the homepage is translated for now.
// BaseLayout already sets dir="rtl" and swaps in the Cairo font when
// Astro.currentLocale === 'ar'. Copy the structure of src/pages/index.astro
// and translate the strings + adapt any layout that assumes LTR reading order.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { identity, contact, hours, ratings, priceRange, amenities } from '../../config/site.config';
---

<BaseLayout title="الرئيسية" path="/ar">
  <section class="relative overflow-hidden bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-accent/60 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-primary-dark">
          ★ {ratings.score}/5 · {ratings.count} تقييم على {ratings.source}
        </p>
        <h1 class="mt-5 font-display text-4xl sm:text-5xl font-bold leading-tight text-text-primary">
          {identity.name}
        </h1>
        <p class="mt-4 text-lg text-text-muted max-w-md">
          مقهى مغربي عصري في {contact.address.city} — تراس خارجي، قاعة خاصة، وخيارات نباتية.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-surface hover:bg-primary-dark transition-colors">
            كيفية الوصول
          </a>
          <a href="/" class="rounded-full border border-primary px-6 py-3 text-sm font-semibold text-primary hover:bg-primary hover:text-surface transition-colors">
            النسخة الفرنسية
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3 text-xs text-text-muted">
          {amenities.map((a) => (
            <li class="rounded-full border border-border bg-surface px-3 py-1">{a}</li>
          ))}
        </ul>
      </div>
      <img
        src="/images/hero/hero-products.jpg"
        alt="رسم توضيحي لمنتجات Zayna Coffee Shop المميزة"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg"
        width="1200"
        height="900"
      />
    </div>
  </section>

  <section class="border-y border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 grid gap-6 sm:grid-cols-3 text-sm">
      <div>
        <p class="font-semibold text-primary">العنوان</p>
        <p class="text-text-muted">{contact.address.full}</p>
      </div>
      <div>
        <p class="font-semibold text-primary">ساعات العمل</p>
        <p class="text-text-muted">{hours.displayText}</p>
      </div>
      <div>
        <p class="font-semibold text-primary">الميزانية</p>
        <p class="text-text-muted">{priceRange.display}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 text-center">
    <p class="text-text-muted text-sm italic">
      ملاحظة: تمت ترجمة الصفحة الرئيسية فقط حتى الآن. بقية الصفحات بالعربية (القائمة، من نحن،
      التقييمات، الأسئلة الشائعة، الاتصال) لم تُبنَ بعد.
    </p>
  </section>
</BaseLayout>
