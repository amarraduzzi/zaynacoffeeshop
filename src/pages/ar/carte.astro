---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ZelligeDivider from '../../components/ZelligeDivider.astro';
import { carteMenuAr as carteMenu, carteNoteAr as carteNote } from '../../content/carte-menu';
---

<BaseLayout title="القائمة" path="/ar/carte">
  <!-- BANNER -->
  <section class="relative h-64 sm:h-80 overflow-hidden">
    <img
      src="/images/carte/mug-shaghaf.jpg"
      alt="قهوة تُقدَّم في Zayna"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="absolute inset-0 flex flex-col justify-end px-4 sm:px-6 lg:px-8 pb-8">
      <div class="mx-auto w-full max-w-4xl">
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-white drop-shadow-sm">القائمة</h1>
        <p class="mt-2 text-sm text-white/90">
          القائمة المقدَّمة في المقهى.
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-xs text-text-muted italic">{carteNote}</p>

    <!-- SEARCH -->
    <div class="sticky top-20 z-30 -mx-4 mt-8 bg-background/95 px-4 py-4 backdrop-blur sm:mx-0 sm:px-0">
      <div class="relative">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
        </svg>
        <input
          id="carte-search"
          type="text"
          placeholder="ابحث عن طبق (مثال: بيغل، طاجين)…"
          class="w-full rounded-full border border-border bg-surface py-3 pr-11 pl-4 text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary/40"
        />
      </div>
      <div class="mt-4 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {carteMenu.map((section, i) => (
          <a
            href={`#section-${i}`}
            class="carte-pill shrink-0 whitespace-nowrap rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-semibold text-text-primary transition-colors hover:border-primary hover:text-primary"
          >
            {section.name}
          </a>
        ))}
      </div>
    </div>

    <p id="carte-empty" class="hidden mt-10 text-center text-sm text-text-muted">
      لا يوجد طبق يطابق بحثك.
    </p>

    <div class="mt-10 space-y-16">
      {carteMenu.map((section, i) => (
        <>
          {i > 0 && <ZelligeDivider class="carte-divider bg-background -mt-4" />}
          <div class="reveal carte-section scroll-mt-40" id={`section-${i}`} data-carte-section>
            <div class="flex items-center gap-4 border-b border-border pb-3">
              <h2 class="font-display text-2xl font-semibold text-primary">{section.name}</h2>
            </div>
            {section.intro && <p class="mt-3 text-sm text-text-muted italic">{section.intro}</p>}

            {section.bannerImage && (
              <div class="mt-5 overflow-hidden rounded-xl">
                <img src={section.bannerImage} alt={section.name} class="h-40 w-full object-cover" />
              </div>
            )}

            <div class="mt-6 grid gap-5 sm:grid-cols-2 [grid-auto-flow:dense]">
              {section.items.map((item) => (
                <div
                  class:list={[
                    'card-lift carte-item flex gap-4 rounded-xl border border-border bg-surface p-4',
                    !item.image && 'sm:col-span-2 sm:flex-row items-start',
                  ]}
                  data-carte-item
                  data-name={item.name.toLowerCase()}
                  data-desc={(item.description ?? '').toLowerCase()}
                >
                {item.image ? (
                  <img src={item.image} alt={item.name} class="h-20 w-20 shrink-0 rounded-lg object-cover" />
                ) : (
                  <div
                    aria-hidden="true"
                    class="hidden h-20 w-20 shrink-0 rounded-lg bg-gradient-to-br from-accent/50 to-primary/20 sm:hidden"
                  />
                )}
                <div class="flex-1">
                  <div class="flex items-start justify-between gap-3">
                    <p class="font-semibold">{item.name}</p>
                    <span class="whitespace-nowrap font-semibold text-primary">{item.price}</span>
                  </div>
                  {item.description && <p class="mt-1 text-sm text-text-muted">{item.description}</p>}
                </div>
              </div>
              ))}
            </div>
          </div>
        </>
      ))}
    </div>
  </div>

  <script>
    const input = document.getElementById('carte-search') as HTMLInputElement | null;
    const emptyMsg = document.getElementById('carte-empty');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-carte-section]'));

    function setSectionVisibility(section: HTMLElement, visible: boolean) {
      section.classList.toggle('hidden', !visible);
      // The decorative divider before each section is a separate sibling
      // element (not inside the section), so hiding the section alone
      // leaves an orphaned divider floating where the hidden section used
      // to be — hide it along with the section it introduces.
      const divider = section.previousElementSibling;
      if (divider && divider.classList.contains('carte-divider')) {
        divider.classList.toggle('hidden', !visible);
      }
    }

    function applyFilter(query: string) {
      const q = query.trim().toLowerCase();
      let anyVisible = false;

      sections.forEach((section) => {
        const items = Array.from(section.querySelectorAll<HTMLElement>('[data-carte-item]'));

        if (q === '') {
          setSectionVisibility(section, true);
          items.forEach((item) => item.classList.remove('hidden'));
          if (items.length > 0 || section.querySelector('img, p')) anyVisible = true;
          return;
        }

        let sectionHasMatch = false;
        items.forEach((item) => {
          const name = item.dataset.name ?? '';
          const desc = item.dataset.desc ?? '';
          const match = name.includes(q) || desc.includes(q);
          item.classList.toggle('hidden', !match);
          if (match) sectionHasMatch = true;
        });

        setSectionVisibility(section, sectionHasMatch);
        if (sectionHasMatch) {
          anyVisible = true;
          // A section revealed only by search may never have scrolled into
          // view, so the .reveal scroll animation (BaseLayout.astro) would
          // otherwise leave it stuck at opacity 0 — force it visible now.
          section.classList.add('reveal-visible');
        }
      });

      emptyMsg?.classList.toggle('hidden', anyVisible || q === '');
    }

    input?.addEventListener('input', () => applyFilter(input.value));

    document.querySelectorAll('.carte-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        if (input && input.value !== '') {
          input.value = '';
          applyFilter('');
        }
      });
    });
  </script>
</BaseLayout>
