---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZelligeDivider from '../components/ZelligeDivider.astro';
import MoroccanHeroBanner from '../components/MoroccanHeroBanner.astro';
import { identity, contact, hours, ratings, priceRange, amenities } from '../config/site.config';
import { menuHighlights } from '../content/menu-highlights';
import { testimonials } from '../content/testimonials';
---

<BaseLayout title="Accueil" path="/">
  <!-- HERO -->
  <section class="relative overflow-hidden bg-surface-muted">
    <MoroccanHeroBanner variant="full" />
    <div class="reveal relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="rounded-3xl bg-surface p-6 sm:p-8 shadow-sm">
        <p class="inline-flex items-center gap-2 rounded-full bg-accent/60 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-primary-dark">
          ★ {ratings.score}/5 · {ratings.count} avis {ratings.source}
        </p>
        <h1 class="mt-5 font-display text-4xl sm:text-5xl font-bold leading-tight text-text-primary">
          {identity.name}
        </h1>
        <p class="mt-4 text-lg text-text-muted max-w-md">
          {identity.tagline} — terrasse extérieure, salle privée et options véganes, à {contact.address.city}.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-surface hover:bg-primary-dark transition-colors">
            Nous trouver
          </a>
          <a href="/menu" class="rounded-full border border-primary px-6 py-3 text-sm font-semibold text-primary hover:bg-primary hover:text-surface transition-colors">
            Voir le menu
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3 text-xs text-text-muted">
          {amenities.map((a) => (
            <li class="rounded-full border border-border bg-surface px-3 py-1">{a}</li>
          ))}
        </ul>
      </div>

      <img
        src="/images/hero/hero-products.jpg"
        alt="Photo des produits signature de Zayna Coffee Shop"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg"
        width="1200"
        height="900"
      />
    </div>
  </section>

  <!-- QUICK INFO STRIP -->
  <section class="border-y border-border bg-surface">
    <div class="reveal mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 grid gap-6 sm:grid-cols-3 text-sm">
      <div>
        <p class="font-semibold text-primary">Adresse</p>
        <p class="text-text-muted">{contact.address.full}</p>
      </div>
      <div>
        <p class="font-semibold text-primary">Horaires</p>
        <p class="text-text-muted">{hours.displayText}</p>
      </div>
      <div>
        <p class="font-semibold text-primary">Budget</p>
        <p class="text-text-muted">{priceRange.display}</p>
      </div>
    </div>
  </section>

  <ZelligeDivider class="bg-surface" />

  <!-- MENU TEASER -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20">
    <div class="reveal flex items-end justify-between gap-4 flex-wrap">
      <h2 class="font-display text-3xl font-bold">Quelques favoris</h2>
      <a href="/menu" class="text-sm font-semibold text-primary hover:underline">Voir tout le menu →</a>
    </div>
    <div class="reveal mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {menuHighlights.flatMap((c) => c.items).slice(0, 3).map((item) => (
        <div class="card-lift rounded-xl border border-border bg-surface p-5">
          {item.image ? (
            <img src={item.image} alt={item.name} class="aspect-video w-full rounded-lg object-cover mb-4" />
          ) : (
            <div class="photo-placeholder aspect-video rounded-lg mb-4">Photo à venir</div>
          )}
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-display font-semibold">{item.name}</h3>
            <span class="text-sm font-semibold text-primary shrink-0">{item.price}</span>
          </div>
          <p class="mt-1 text-sm text-text-muted">{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TESTIMONIALS TEASER -->
  <section class="bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20">
      <div class="reveal">
        <h2 class="font-display text-3xl font-bold">Ce que disent nos clients</h2>
        <p class="mt-2 text-sm text-text-muted">
          Note moyenne {ratings.score}/5 sur {ratings.count} avis {ratings.source}.
        </p>
      </div>
      <div class="reveal mt-8 grid gap-6 sm:grid-cols-3">
        {testimonials.map((t) => (
          <blockquote class="card-lift rounded-xl bg-surface border border-border p-6 text-sm">
            <p class="text-text-primary">"{t.text}"</p>
            <footer class="mt-4 text-xs text-text-muted">— {t.author}</footer>
          </blockquote>
        ))}
      </div>
      <a href="/avis" class="mt-8 inline-block text-sm font-semibold text-primary hover:underline">Lire tous les avis →</a>
    </div>
  </section>

  <ZelligeDivider class="bg-background" />

  <!-- CTA -->
  <section class="relative overflow-hidden py-20 text-center">
    <MoroccanHeroBanner variant="strip" />
    <div class="reveal relative mx-auto max-w-2xl rounded-3xl bg-surface px-6 py-10 shadow-sm">
      <h2 class="font-display text-3xl font-bold">Venez nous rendre visite</h2>
      <p class="mt-3 text-text-muted">{contact.address.full}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={contact.phone.href} class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-surface hover:bg-primary-dark transition-colors">
          Appeler · {contact.phone.display}
        </a>
        <a href={contact.mapLinkHref} class="rounded-full border border-primary px-6 py-3 text-sm font-semibold text-primary hover:bg-primary hover:text-surface transition-colors">
          Itinéraire
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
