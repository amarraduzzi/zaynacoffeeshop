---
import BaseLayout from '../layouts/BaseLayout.astro';
import { carteMenu, carteNote } from '../content/carte-menu';
---

<BaseLayout title="La carte" path="/carte">
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="font-display text-4xl font-bold">La carte</h1>
    <p class="mt-3 text-text-muted">
      Le menu servi sur place, au café. (Vous cherchez le menu livraison ? Voir
      <a href="/menu" class="text-primary hover:underline">la page Menu</a>.)
    </p>
    <p class="mt-2 text-xs text-text-muted italic">{carteNote}</p>

    <div class="mt-12 space-y-14">
      {carteMenu.map((section) => (
        <div>
          <h2 class="font-display text-2xl font-semibold text-primary border-b border-border pb-3">
            {section.name}
          </h2>
          {section.intro && <p class="mt-3 text-sm text-text-muted italic">{section.intro}</p>}
          <ul class="mt-6 space-y-6">
            {section.items.map((item) => (
              <li class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold">{item.name}</p>
                  {item.description && <p class="text-sm text-text-muted mt-1">{item.description}</p>}
                </div>
                <span class="font-semibold text-primary shrink-0 whitespace-nowrap">{item.price}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
