---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoroccanHeroBanner from '../components/MoroccanHeroBanner.astro';
import { ratings } from '../config/site.config';
import { testimonials } from '../content/testimonials';
---

<BaseLayout title="Avis" path="/avis">
  <section class="relative h-56 overflow-hidden">
    <MoroccanHeroBanner variant="strip" />
    <div class="relative flex h-full items-center justify-center px-4 text-center">
      <h1 class="rounded-2xl bg-surface px-8 py-4 font-display text-4xl font-bold shadow-sm">
        Avis clients
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <p class="flex items-center gap-2 text-lg">
      <span class="text-primary font-semibold">★ {ratings.score}/5</span>
      <span class="text-text-muted text-sm">({ratings.count} avis {ratings.source})</span>
    </p>
    <p class="mt-2 text-sm text-text-muted italic">
      Les avis ci-dessous sont des exemples de mise en page — à remplacer par de vrais avis Google
      (avec l'accord des auteurs) avant la mise en ligne.
    </p>

    <div class="mt-10 space-y-6">
      {testimonials.map((t) => (
        <blockquote class="rounded-xl border border-border bg-surface-muted p-6">
          <div class="text-primary text-sm" aria-hidden="true">{'★'.repeat(t.rating)}</div>
          <p class="mt-2 text-text-primary">"{t.text}"</p>
          <footer class="mt-3 text-xs text-text-muted">— {t.author}</footer>
        </blockquote>
      ))}
    </div>
  </section>
</BaseLayout>
