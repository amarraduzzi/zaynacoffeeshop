---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoroccanHeroBanner from '../components/MoroccanHeroBanner.astro';
import OrderApp from '../cart/OrderApp';
---

<BaseLayout title="Commander" path="/menu">
  <section class="relative h-56 overflow-hidden">
    <MoroccanHeroBanner variant="strip" />
    <div class="relative flex h-full items-center justify-center px-4 text-center">
      <h1 class="rounded-2xl bg-surface px-8 py-4 font-display text-4xl font-bold shadow-sm">
        Commander en ligne
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-8 rounded-xl border-2 border-amber-400 bg-amber-50 px-5 py-4 text-center sm:text-left" role="alert">
      <p class="font-display text-lg font-bold text-amber-900">
        Bientôt disponible
      </p>
      <p class="mt-1 text-sm font-medium text-amber-800">
        La commande en ligne via WhatsApp sera possible très prochainement. Merci de votre patience !
      </p>
    </div>

    <p class="text-text-muted">
      Ajoutez des articles à votre panier, puis validez votre commande — elle part directement sur
      WhatsApp. Vous êtes sur place ? Voir <a href="/carte" class="text-primary hover:underline">la carte du café</a>.
    </p>

    <OrderApp client:load locale="fr" />
  </section>
</BaseLayout>
