---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoroccanOrnament from '../components/MoroccanOrnament.astro';
import OrderApp from '../cart/OrderApp';
---

<BaseLayout title="Commander" path="/menu">
  <section class="relative overflow-hidden mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <MoroccanOrnament corner="top-right" size={200} />
    <h1 class="font-display text-4xl font-bold">Commander en ligne</h1>
    <p class="mt-3 text-text-muted">
      Ajoutez des articles à votre panier, puis validez votre commande — elle part directement sur
      WhatsApp. Vous êtes sur place ? Voir <a href="/carte" class="text-primary hover:underline">la carte du café</a>.
    </p>

    <OrderApp client:load />
  </section>
</BaseLayout>
