---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ZelligeDivider from '../../components/ZelligeDivider.astro';
import MoroccanHeroBanner from '../../components/MoroccanHeroBanner.astro';
import { identity, amenitiesEn as amenities, contact } from '../../config/site.config';
---

<!--
  DEMO COPY NOTICE — same imagined-owner-voice story as the French page,
  translated. Not the owner's real words yet. See src/pages/a-propos.astro.
-->
<BaseLayout title="About" path="/en/a-propos">
  <section class="relative h-56 overflow-hidden">
    <MoroccanHeroBanner variant="strip" />
    <div class="relative flex h-full items-center justify-center px-4 text-center">
      <h1 class="reveal rounded-2xl bg-surface px-8 py-4 font-display text-4xl font-bold shadow-sm">
        About {identity.shortName}
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal space-y-4 text-text-muted">
        <p>
          I opened {identity.name} because I was looking, in {contact.address.city}, for the kind of
          place I'd want to sit in myself — a café where things are done properly, without ever
          taking itself too seriously.
        </p>
        <p>
          On the menu, every breakfast is named after somewhere else — the American-style Miricani,
          the so-British Nglizi with its homemade scones, the deeply local Mghribi — because that's
          the idea of the café, really: recipes from elsewhere, made with a Moroccan heart.
        </p>
        <p>
          The terracotta on the walls, the zellige patterns you'll find down to our logo — that's
          not decoration bolted on afterward. It's the heritage we wanted to honor, told in a
          simple, warm, present-day language. Whether you come alone with a book on the terrace,
          with friends in the private room, or you're vegan, I wanted there to be a place for you
          here.
        </p>
      </div>
      <!-- PHOTO: team / interior photo -->
      <div class="photo-placeholder aspect-square rounded-2xl">Photo coming soon — team or interior</div>
    </div>

    <ZelligeDivider class="mt-14 bg-background" />

    <div class="mt-2">
      <h2 class="reveal font-display text-2xl font-semibold">What we offer</h2>
      <ul class="reveal mt-6 grid gap-4 sm:grid-cols-3">
        {amenities.map((a) => (
          <li class="card-lift rounded-xl border border-border bg-surface-muted p-5 text-sm font-medium">{a}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
