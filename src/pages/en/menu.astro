---
// The WhatsApp order cart that used to live here was removed at the
// client's request (2026-08-31) — she no longer wants to take orders
// through the site. This page now just forwards anyone who had it
// bookmarked (or finds it via an old Google result) straight to the
// in-store menu, which is the real, current menu.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="In-store menu" path="/en/menu">
  <meta http-equiv="refresh" content="0; url=/en/carte" />
  <section class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-text-muted">
      Redirecting to <a href="/en/carte" class="text-primary underline">the in-store menu</a>…
    </p>
  </section>
</BaseLayout>
