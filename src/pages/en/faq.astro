---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoroccanHeroBanner from '../../components/MoroccanHeroBanner.astro';
import { faqEn as faq } from '../../content/faq';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout title="FAQ" path="/en/faq">
  <section class="relative h-56 overflow-hidden">
    <MoroccanHeroBanner variant="strip" />
    <div class="relative flex h-full items-center justify-center px-4 text-center">
      <h1 class="rounded-2xl bg-surface px-8 py-4 font-display text-4xl font-bold shadow-sm">
        Frequently Asked Questions
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="divide-y divide-border rounded-xl border border-border bg-surface">
      {faq.map((item) => (
        <details class="group p-5">
          <summary class="cursor-pointer list-none font-semibold flex items-center justify-between gap-4">
            {item.question}
            <span class="text-primary transition-transform group-open:rotate-45 shrink-0">+</span>
          </summary>
          <p class="mt-3 text-sm text-text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
