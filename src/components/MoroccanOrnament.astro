---
// Recurring decorative motif per the owner's brief: "Moroccan café ornament"
// — simplified 8-point stars, small zellige clusters, a subtle arch, coffee
// beans and a leaf sprig, a mini lantern, lots of breathing room around them.
// Built as one inline SVG (no external asset, no extra request) so it can be
// dropped into any section as a quiet corner accent — never a full tiled
// wall, always mostly empty space, per the reference mood board. Colors stay
// inside the existing brand palette (terracotta / beige / dark terracotta)
// rather than introducing the reference's blue, so it reads as *this* café's
// mark rather than a generic Moroccan stock texture.
interface Props {
  corner?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  class?: string;
  size?: number;
}
const { corner = 'top-right', class: className = '', size = 260 } = Astro.props;

const flipX = corner === 'top-left' || corner === 'bottom-left';
const flipY = corner === 'bottom-left' || corner === 'bottom-right';
const positionClass = {
  'top-right': 'top-0 right-0',
  'top-left': 'top-0 left-0',
  'bottom-right': 'bottom-0 right-0',
  'bottom-left': 'bottom-0 left-0',
}[corner];
const transform = `scale(${flipX ? -1 : 1}, ${flipY ? -1 : 1})`;
---

<svg
  aria-hidden="true"
  class:list={['pointer-events-none absolute select-none', positionClass, className]}
  width={size}
  height={size}
  viewBox="0 0 220 220"
  fill="none"
  style={{ transform }}
>
  <!-- subtle keyhole arch, bottom edge -->
  <path
    d="M20 210 V150 a40 40 0 0 1 80 0 V210"
    stroke="var(--color-primary)"
    stroke-width="2"
    opacity="0.18"
  />

  <!-- large simplified 8-point star -->
  <path
    d="M150 20 L160 42 L184 32 L174 56 L198 66 L174 76 L184 100 L160 90 L150 112 L140 90 L116 100 L126 76 L102 66 L126 56 L116 32 L140 42 Z"
    stroke="var(--color-primary)"
    stroke-width="2"
    opacity="0.25"
  />

  <!-- small companion star -->
  <path
    d="M188 118 L192 128 L203 124 L198 135 L209 140 L198 145 L203 156 L192 152 L188 162 L184 152 L173 156 L178 145 L167 140 L178 135 L173 124 L184 128 Z"
    fill="var(--color-accent)"
    opacity="0.35"
  />

  <!-- tiny zellige cluster: three small tiles -->
  <g opacity="0.3">
    <rect x="30" y="40" width="14" height="14" rx="2" transform="rotate(45 37 47)" fill="var(--color-primary)" />
    <rect x="48" y="30" width="10" height="10" rx="2" transform="rotate(45 53 35)" fill="var(--color-accent)" />
    <rect x="20" y="24" width="9" height="9" rx="2" transform="rotate(45 24.5 28.5)" fill="var(--color-primary)" />
  </g>

  <!-- mini lantern -->
  <g opacity="0.28" stroke="var(--color-primary)" stroke-width="1.6">
    <path d="M100 150 L106 140 L112 150 Z" />
    <rect x="101" y="150" width="10" height="16" rx="1.5" />
    <line x1="101" y1="155" x2="111" y2="155" />
    <line x1="101" y1="161" x2="111" y2="161" />
    <path d="M104 166 L108 166 L106 172 Z" />
  </g>

  <!-- coffee beans -->
  <g opacity="0.4">
    <ellipse cx="60" cy="190" rx="9" ry="6" transform="rotate(-25 60 190)" fill="var(--color-primary)" />
    <path d="M56 190 Q60 185 64 190" stroke="var(--color-background)" stroke-width="1.2" transform="rotate(-25 60 190)" />
    <ellipse cx="76" cy="182" rx="7" ry="4.6" transform="rotate(-15 76 182)" fill="var(--color-primary)" />
    <path d="M73 182 Q76 178.5 79 182" stroke="var(--color-background)" stroke-width="1" transform="rotate(-15 76 182)" />
  </g>

  <!-- mint sprig -->
  <g opacity="0.32" stroke="var(--color-primary)" stroke-width="1.4" stroke-linecap="round">
    <path d="M92 200 Q100 186 96 168" fill="none" />
    <path d="M96 195 Q88 192 86 184" fill="none" />
    <path d="M95 183 Q104 181 106 172" fill="none" />
    <path d="M96 168 Q92 162 96 156" fill="none" />
  </g>
</svg>
