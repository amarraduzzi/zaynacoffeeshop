---
// The site's signature decorative banner — a hand-built SVG illustration in
// the "Moroccan café ornament" style the owner asked for: simplified 8-point
// star mosaics in terracotta/gold/navy, a keyhole arch, a stylized coffee cup
// with steam, mint leaves, coffee beans, a mini lantern, and generous cream
// negative space between the clusters (deliberately NOT a tiled wall — see
// the reference mood board). One SVG, reused full-bleed behind every page's
// intro section so the same visual language repeats site-wide.
//
// `variant="full"` = the dense two-corner version (homepage hero).
// `variant="strip"` = a shorter, single-corner version for page title bands
// on the secondary pages, where vertical space is tighter.
//
// Two copies of the same artwork are rendered below (desktop / mobile).
// On wide screens `preserveAspectRatio="xMidYMid slice"` centers and crops
// the banner across the FULL section height — fine on desktop, because both
// corner clusters stay near the edges of a wide viewport.
//
// On mobile that "fill the whole section" approach broke two different ways:
// centered (xMidYMid) cropping landed on the empty middle of the artwork, so
// the banner looked blank — and later, left-aligned (xMinYMid) cropping
// stretched the medallion across the section's full (and very tall, once
// text stacks on phones) height, blowing it up to an unusably huge zoom.
// The real fix is to stop tying the mobile artwork to the section's height
// at all: it's now a fixed, compact strip pinned to the top of the section
// (h-28 / h-36 below), so the zoom level is always predictable no matter how
// tall the page content underneath happens to be. Desktop is untouched.
interface Props {
  variant?: 'full' | 'strip';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
const height = variant === 'full' ? 500 : 260;
const VARIANTS = [
  { key: 'desktop', wrapperClass: 'hidden md:block absolute inset-0 h-full w-full', align: 'xMidYMid' },
  { key: 'mobile', wrapperClass: 'md:hidden absolute inset-x-0 top-0 w-full h-28', align: 'xMinYMid' },
];
---

{VARIANTS.map(({ key, wrapperClass, align }) => (
  <svg
    aria-hidden="true"
    class:list={['pointer-events-none', wrapperClass, className]}
    viewBox={`0 0 1600 ${height}`}
    preserveAspectRatio={`${align} slice`}
    fill="none"
    data-banner={key}
  >
    <defs>
      <radialGradient id={`mrc-glow-${key}`} cx="50%" cy="50%" r="60%">
        <stop offset="0%" stop-color="#AA5432" stop-opacity="0.08" />
        <stop offset="100%" stop-color="#AA5432" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="1600" height={height} fill="#FBF7EF" />
    <rect width="1600" height={height} fill={`url(#mrc-glow-${key})`} />

    <!-- ===================== TOP-LEFT MOSAIC MEDALLION ===================== -->
    <g transform={`translate(60 ${variant === 'full' ? -20 : -60})`}>
      <circle cx="140" cy="140" r="150" fill="#3B5166" opacity="0.08" />
      <g opacity="0.9">
        <path d="M140 20 L162 70 L216 58 L182 100 L228 130 L182 160 L216 202 L162 190 L140 240 L118 190 L64 202 L98 160 L52 130 L98 100 L64 58 L118 70 Z" fill="#AA5432" opacity="0.85" />
        <path d="M140 55 L153 82 L182 76 L163 100 L188 117 L163 134 L182 158 L153 152 L140 179 L127 152 L98 158 L117 134 L92 117 L117 100 L98 76 L127 82 Z" fill="#D9A441" opacity="0.9" />
        <circle cx="140" cy="117" r="14" fill="#3B5166" opacity="0.85" />
      </g>
      <path d="M40 78 L48 96 L68 100 L52 112 L56 132 L40 121 L24 132 L28 112 L12 100 L32 96 Z" fill="#3B5166" opacity="0.5" />
      <path d="M226 40 L232 54 L248 56 L236 66 L239 82 L226 74 L213 82 L216 66 L204 56 L220 54 Z" fill="#D9A441" opacity="0.55" />
    </g>

    <!-- keyhole arch + palm/minaret silhouette, bottom-left -->
    <g transform={`translate(20 ${height - 190})`} opacity="0.55">
      <path d="M10 190 V110 a70 70 0 0 1 140 0 V190" stroke="#AA5432" stroke-width="3" fill="none" />
      <path d="M18 190 V115 a62 62 0 0 1 124 0 V190" stroke="#D9A441" stroke-width="1.5" fill="none" opacity="0.7" />
      <g fill="#C9BBA0" opacity="0.6">
        <rect x="100" y="150" width="8" height="40" />
        <path d="M96 150 L104 130 L112 150 Z" />
        <circle cx="104" cy="122" r="4" />
      </g>
      <path d="M60 190 V150 Q60 120 40 108 Q52 132 50 160 V190 M40 108 Q30 118 26 140" stroke="#8FA085" stroke-width="3" fill="none" opacity="0.6" stroke-linecap="round" />
    </g>

    <!-- scattered small stars, sprinkled thin across the middle so the banner
         reads as one continuous motif rather than two isolated corners -->
    <g fill="#AA5432" opacity="0.28">
      <path d="M420 60 l5 12 13 1 -10 8 4 13 -12-7 -12 7 4-13 -10-8 13-1z" />
      <path d="M700 130 l4 9 10 1 -7 6 3 10 -10-6 -10 6 3-10 -7-6 10-1z" />
      <path d="M980 50 l4 9 10 1 -7 6 3 10 -10-6 -9 6 3-10 -7-6 10-1z" />
    </g>
    <g fill="#D9A441" opacity="0.32">
      <circle cx="520" cy="90" r="3" />
      <circle cx="860" cy="170" r="3.5" />
      <circle cx="1120" cy="80" r="3" />
    </g>

    <!-- ===================== RIGHT SIDE: ARCH + COFFEE CUP CLUSTER ===================== -->
    <g transform={`translate(${1600 - 420} ${height - (variant === 'full' ? 340 : 220)})`}>
      <!-- arch backdrop -->
      <path d="M40 340 V150 a80 80 0 0 1 160 0 V340" fill="#AA5432" opacity="0.9" />
      <path d="M50 340 V152 a70 70 0 0 1 140 0 V340" fill="#D9A441" opacity="0.25" />

      <!-- mini lantern, right of the arch -->
      <g transform="translate(230 40)" opacity="0.85">
        <line x1="20" y1="0" x2="20" y2="26" stroke="#D9A441" stroke-width="1.5" />
        <path d="M8 26 L20 14 L32 26 Z" fill="#D9A441" />
        <rect x="9" y="26" width="22" height="34" rx="3" fill="#D9A441" opacity="0.9" />
        <line x1="9" y1="35" x2="31" y2="35" stroke="#3B5166" stroke-width="1.2" opacity="0.5" />
        <line x1="9" y1="45" x2="31" y2="45" stroke="#3B5166" stroke-width="1.2" opacity="0.5" />
        <path d="M14 60 L26 60 L20 74 Z" fill="#D9A441" />
      </g>

      <!-- small star + tile accents around the arch -->
      <path d="M235 -10 l6 14 15 1 -11 10 4 15 -14-8 -14 8 4-15 -11-10 15-1z" fill="#AA5432" opacity="0.4" />
      <rect x="8" y="8" width="16" height="16" rx="2" transform="rotate(45 16 16)" fill="#3B5166" opacity="0.35" />

      <!-- steam swirl -->
      <path
        d="M95 130 Q108 108 96 88 Q86 72 100 55"
        stroke="#3B5166"
        stroke-width="2.5"
        fill="none"
        opacity="0.35"
        stroke-linecap="round"
      />

      <!-- saucer + cup, flat decorative style -->
      <ellipse cx="100" cy="205" rx="72" ry="14" fill="#3B5166" opacity="0.18" />
      <path d="M46 150 Q46 195 100 195 Q154 195 154 150 Z" fill="#FBF7EF" stroke="#AA5432" stroke-width="2.5" />
      <path d="M52 155 Q52 188 100 188 Q148 188 148 155 Z" fill="#AA5432" opacity="0.9" />
      <!-- simple latte-art flower -->
      <g stroke="#FBF7EF" stroke-width="2" fill="none" opacity="0.9">
        <path d="M100 160 Q106 170 100 182 Q94 170 100 160 Z" />
        <path d="M86 168 Q100 172 114 168" />
        <path d="M90 176 Q100 179 110 176" />
      </g>
      <path d="M150 160 q18 4 18 20 q0 16 -18 14" fill="none" stroke="#AA5432" stroke-width="4" stroke-linecap="round" />

      <!-- mint sprig + beans, front of the cup -->
      <g transform="translate(20 185)" opacity="0.85">
        <path d="M18 40 Q26 20 20 0" stroke="#7C8F6E" stroke-width="2" fill="none" stroke-linecap="round" />
        <path d="M20 30 Q10 27 8 18" stroke="#7C8F6E" stroke-width="1.6" fill="none" />
        <path d="M19 15 Q29 13 31 4" stroke="#7C8F6E" stroke-width="1.6" fill="none" />
      </g>
      <g transform="translate(150 195)" opacity="0.9">
        <ellipse cx="0" cy="0" rx="10" ry="6.5" transform="rotate(-25 0 0)" fill="#3B5166" />
        <path d="M-4 0 Q0 -5 4 0" stroke="#FBF7EF" stroke-width="1.2" transform="rotate(-25 0 0)" />
        <ellipse cx="18" cy="8" rx="8" ry="5" transform="rotate(-15 18 8)" fill="#3B5166" />
        <path d="M14 8 Q18 4 22 8" stroke="#FBF7EF" stroke-width="1" transform="rotate(-15 18 8)" />
      </g>
    </g>
  </svg>
))}
