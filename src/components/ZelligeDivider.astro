---
// A thin recurring 8-point-star motif used between sections — the same
// visual language as the hero illustration and logo, repeated as a small
// decorative thread through the page instead of appearing once and never
// again. Deliberately understated: 20px tall, low-opacity, one color.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['flex items-center justify-center gap-3 py-2', className]} aria-hidden="true">
  <span class="h-px w-12 bg-border"></span>
  <svg width="16" height="16" viewBox="0 0 24 24" class="text-primary/50">
    <path
      d="M12 2l1.8 4.1L18 7l-3 3.1L15.9 14 12 12.1 8.1 14 9 10.1 6 7l4.2-.9z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    />
  </svg>
  <span class="h-px w-12 bg-border"></span>
</div>
