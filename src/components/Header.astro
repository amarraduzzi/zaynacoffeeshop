---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { identity, nav } from '../config/site.config';

const currentPath = Astro.url.pathname;
const locale = Astro.currentLocale ?? 'fr';

function isActive(href: string) {
  const localizedHref = getRelativeLocaleUrl(locale, href === '/' ? '' : href);
  return currentPath === localizedHref || currentPath === localizedHref + '/';
}
---

<header class="sticky top-0 z-50 bg-surface/95 backdrop-blur border-b border-border">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <a href={getRelativeLocaleUrl(locale, '')} class="flex items-center gap-3 shrink-0">
        <img src="/images/logo.png" alt={identity.name} class="h-12 w-12 rounded-full" />
        <span class="font-display text-lg sm:text-xl font-semibold text-primary leading-tight">
          {identity.shortName}
          <span class="block text-[0.6rem] tracking-[0.2em] uppercase text-text-muted font-body font-normal">
            Coffee Shop
          </span>
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-8">
        {nav.map((item) => (
          <a
            href={getRelativeLocaleUrl(locale, item.href === '/' ? '' : item.href)}
            class:list={[
              'text-sm font-medium transition-colors hover:text-primary',
              isActive(item.href) ? 'text-primary' : 'text-text-primary',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="hidden md:flex items-center gap-4">
        <div class="flex items-center gap-1 text-xs text-text-muted">
          <a href={getRelativeLocaleUrl('fr', '')} class:list={[locale === 'fr' && 'font-bold text-primary']}>FR</a>
          <span>·</span>
          <a href={getRelativeLocaleUrl('en', '')} class:list={[locale === 'en' && 'font-bold text-primary']}>EN</a>
          <span>·</span>
          <a href={getRelativeLocaleUrl('ar', '')} class:list={[locale === 'ar' && 'font-bold text-primary']}>AR</a>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, 'menu')}
          class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-surface hover:bg-primary-dark transition-colors"
        >
          Commander
        </a>
      </div>

      <button
        id="menu-toggle"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-text-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="md:hidden hidden border-t border-border bg-surface">
    <div class="px-4 py-3 flex flex-col gap-1">
      {nav.map((item) => (
        <a
          href={getRelativeLocaleUrl(locale, item.href === '/' ? '' : item.href)}
          class="rounded-md px-3 py-2 text-sm font-medium text-text-primary hover:bg-surface-muted"
        >
          {item.label}
        </a>
      ))}
      <div class="flex items-center gap-3 px-3 pt-2 text-xs text-text-muted">
        <a href={getRelativeLocaleUrl('fr', '')}>FR</a>
        <a href={getRelativeLocaleUrl('en', '')}>EN</a>
        <a href={getRelativeLocaleUrl('ar', '')}>AR</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
