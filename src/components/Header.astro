---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { identity, nav, navLabels as NAV_LABELS } from '../config/site.config';

const currentPath = Astro.url.pathname;
const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en' | 'ar';

// Every page now exists in all three locales (fr unprefixed, /en/*, /ar/*)
// — see src/pages/en/*.astro and src/pages/ar/*.astro. So nav links and the
// language switcher both route to the real translated page, not just the
// homepage.

const menuAriaLabel = { fr: 'Ouvrir le menu', en: 'Open menu', ar: 'فتح القائمة' }[locale];
const langMenuAriaLabel = { fr: 'Choisir la langue', en: 'Choose language', ar: 'اختر اللغة' }[locale];
const orderLabel = NAV_LABELS['/menu'][locale];
const LOCALES = ['fr', 'en', 'ar'] as const;

function labelFor(href: string) {
  return NAV_LABELS[href]?.[locale] ?? href;
}

function hrefFor(href: string) {
  const slug = href === '/' ? '' : href.replace(/^\//, '');
  return getRelativeLocaleUrl(locale, slug);
}

function isActive(href: string) {
  return currentPath === hrefFor(href) || currentPath === hrefFor(href) + '/';
}

// The current route with any locale prefix stripped, e.g. "/en/carte" -> "/carte",
// "/ar" -> "/" — used so the language switcher lands on the SAME page in the
// new language instead of resetting to the homepage.
const routeWithoutLocale = (() => {
  let p = currentPath.replace(/^\/(en|ar)(?=\/|$)/, '');
  if (p === '') p = '/';
  return p;
})();

function localeSwitchHref(targetLocale: 'fr' | 'en' | 'ar') {
  const slug = routeWithoutLocale === '/' ? '' : routeWithoutLocale.replace(/^\//, '');
  return getRelativeLocaleUrl(targetLocale, slug);
}
---

<header class="sticky top-0 z-50 bg-surface/95 backdrop-blur border-b border-border">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <a href={getRelativeLocaleUrl(locale, '')} class="flex items-center gap-3 shrink-0">
        <img src="/images/logo.png" alt={identity.name} class="h-12 w-12 rounded-full" />
        <span class="font-display text-lg sm:text-xl font-semibold text-primary leading-tight">
          {identity.shortName}
          <span class="block text-[0.6rem] tracking-[0.2em] uppercase text-text-muted font-body font-normal">
            Coffee Shop
          </span>
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-8">
        {nav.map((item) => (
          <a
            href={hrefFor(item.href)}
            class:list={[
              'text-sm font-medium transition-colors hover:text-primary',
              isActive(item.href) ? 'text-primary' : 'text-text-primary',
            ]}
          >
            {labelFor(item.href)}
          </a>
        ))}
      </nav>

      <div class="hidden md:flex items-center gap-4">
        <div class="flex items-center gap-1 text-xs text-text-muted">
          <a href={localeSwitchHref('fr')} class:list={[locale === 'fr' && 'font-bold text-primary']}>FR</a>
          <span>·</span>
          <a href={localeSwitchHref('en')} class:list={[locale === 'en' && 'font-bold text-primary']}>EN</a>
          <span>·</span>
          <a href={localeSwitchHref('ar')} class:list={[locale === 'ar' && 'font-bold text-primary']}>AR</a>
        </div>
        <a
          href={hrefFor('/menu')}
          class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-surface hover:bg-primary-dark transition-colors"
        >
          {orderLabel}
        </a>
      </div>

      <!-- Mobile-only language switcher — sits in the header bar itself
           (not tucked inside the hamburger menu), expands into a small
           dropdown with the 3 language choices. -->
      <div class="relative md:hidden">
        <button
          id="lang-toggle"
          aria-label={langMenuAriaLabel}
          aria-expanded="false"
          class="inline-flex items-center gap-1 rounded-md px-2 py-2 text-sm font-semibold text-primary"
        >
          {locale.toUpperCase()}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform" id="lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="lang-dropdown"
          class="hidden absolute right-0 top-full mt-1 min-w-[6rem] overflow-hidden rounded-lg border border-border bg-surface shadow-lg z-50"
        >
          {LOCALES.map((l) => (
            <a
              href={localeSwitchHref(l)}
              class:list={[
                'block px-4 py-2 text-sm hover:bg-surface-muted',
                l === locale ? 'font-bold text-primary' : 'text-text-primary',
              ]}
            >
              {{ fr: 'Français', en: 'English', ar: 'العربية' }[l]}
            </a>
          ))}
        </div>
      </div>

      <button
        id="menu-toggle"
        aria-label={menuAriaLabel}
        aria-expanded="false"
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-text-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="md:hidden hidden border-t border-border bg-surface">
    <div class="px-4 py-3 flex flex-col gap-1">
      {nav.map((item) => (
        <a
          href={hrefFor(item.href)}
          class="rounded-md px-3 py-2 text-sm font-medium text-text-primary hover:bg-surface-muted"
        >
          {labelFor(item.href)}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    // Closing one mobile panel closes the other, so they never overlap.
    if (!isOpen) {
      langDropdown?.classList.add('hidden');
      langToggle?.setAttribute('aria-expanded', 'false');
      langChevron?.classList.remove('rotate-180');
    }
  });

  const langToggle = document.getElementById('lang-toggle');
  const langDropdown = document.getElementById('lang-dropdown');
  const langChevron = document.getElementById('lang-chevron');
  langToggle?.addEventListener('click', () => {
    const isOpen = !langDropdown?.classList.contains('hidden');
    langDropdown?.classList.toggle('hidden');
    langToggle.setAttribute('aria-expanded', String(!isOpen));
    langChevron?.classList.toggle('rotate-180');
    if (!isOpen) {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('click', (e) => {
    if (!langToggle || !langDropdown) return;
    if (!langToggle.contains(e.target as Node) && !langDropdown.contains(e.target as Node)) {
      langDropdown.classList.add('hidden');
      langToggle.setAttribute('aria-expanded', 'false');
      langChevron?.classList.remove('rotate-180');
    }
  });
</script>
