---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { identity, contact, hours, nav, socials, navLabels } from '../config/site.config';

const locale = (Astro.currentLocale ?? 'fr') as 'fr' | 'en' | 'ar';
const year = new Date().getFullYear();

const footerCopy = {
  fr: { nav: 'Navigation', contact: 'Contact', follow: 'Suivez-nous', linksTodo: 'Liens à ajouter', rights: 'Tous droits réservés.' },
  en: { nav: 'Navigation', contact: 'Contact', follow: 'Follow us', linksTodo: 'Links to add', rights: 'All rights reserved.' },
  ar: { nav: 'التصفح', contact: 'اتصل بنا', follow: 'تابعونا', linksTodo: 'روابط لإضافتها', rights: 'جميع الحقوق محفوظة.' },
}[locale];
---

<footer class="zellige-pattern relative mt-24 bg-primary text-surface bg-blend-overlay" style="background-color: rgba(170,84,50,0.94); background-size: 48px 48px;">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-3">
        <img src="/images/logo-white.png" alt={identity.name} class="h-10 w-10 rounded-full" />
        <span class="font-display text-lg font-semibold">{identity.shortName}</span>
      </div>
      <p class="mt-3 text-sm text-surface/80">{identity.tagline}</p>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-accent">{footerCopy.nav}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, item.href === '/' ? '' : item.href.replace(/^\//, ''))}
              class="text-surface/85 hover:text-surface"
            >
              {navLabels[item.href]?.[locale] ?? item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-accent">{footerCopy.contact}</h3>
      <ul class="mt-3 space-y-2 text-sm text-surface/85">
        <li>{contact.address.full}</li>
        <li><a href={contact.phone.href} class="hover:text-surface">{contact.phone.display}</a></li>
        <li>{hours.displayText}</li>
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-accent">{footerCopy.follow}</h3>
      <ul class="mt-3 space-y-2 text-sm text-surface/85">
        {socials.instagram && <li><a href={socials.instagram} class="hover:text-surface">Instagram</a></li>}
        {socials.facebook && <li><a href={socials.facebook} class="hover:text-surface">Facebook</a></li>}
        {socials.tiktok && <li><a href={socials.tiktok} class="hover:text-surface">TikTok</a></li>}
        {!socials.instagram && !socials.facebook && !socials.tiktok && (
          <li class="text-surface/60 italic">{footerCopy.linksTodo}</li>
        )}
      </ul>
    </div>
  </div>

  <div class="border-t border-surface/20">
    <p class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4 text-xs text-surface/70">
      © {year} {identity.name}. {footerCopy.rights}
    </p>
  </div>
</footer>
