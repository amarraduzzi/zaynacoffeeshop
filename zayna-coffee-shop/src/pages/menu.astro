---
import BaseLayout from '../layouts/BaseLayout.astro';
import { menuHighlights, menuNote } from '../content/menu-highlights';
---

<BaseLayout title="Menu" path="/menu">
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="font-display text-4xl font-bold">Notre menu</h1>
    <p class="mt-3 text-text-muted">{menuNote}</p>

    <div class="mt-12 space-y-14">
      {menuHighlights.map((category) => (
        <div>
          <h2 class="font-display text-2xl font-semibold text-primary border-b border-border pb-3">
            {category.name}
          </h2>
          <ul class="mt-6 space-y-6">
            {category.items.map((item) => (
              <li class="flex items-start gap-4">
                {item.image && (
                  <img
                    src={item.image}
                    alt={item.name}
                    class="h-16 w-16 shrink-0 rounded-lg object-cover"
                  />
                )}
                <div class="flex flex-1 items-start justify-between gap-4">
                  <div>
                    <p class="font-semibold flex items-center gap-2">
                      {item.name}
                      {item.vegan && (
                        <span class="rounded-full bg-accent/60 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-primary-dark">
                          Végane
                        </span>
                      )}
                    </p>
                    <p class="text-sm text-text-muted mt-1">{item.description}</p>
                  </div>
                  <span class="font-semibold text-primary shrink-0">{item.price}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
