---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { identity, contact, hours, ratings, priceRange } from '../config/site.config';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description = identity.description, path = '' } = Astro.props;
const locale = Astro.currentLocale ?? 'fr';
const canonical = new URL(path, identity.siteUrl).toString();
const dir = locale === 'ar' ? 'rtl' : 'ltr';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: identity.name,
  description: identity.description,
  image: `${identity.siteUrl}/images/logo.png`,
  telephone: contact.phone.display,
  priceRange: priceRange.display,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    postalCode: contact.address.postalCode,
    addressCountry: 'MA',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: ratings.score,
    reviewCount: ratings.count,
  },
  url: identity.siteUrl,
};
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title} · {identity.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · ${identity.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${identity.siteUrl}/images/logo.png`} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&family=Cairo:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
